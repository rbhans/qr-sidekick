{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QRBAS Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/server",
      "args": ["-port", "8080"]
    },
    {
      "name": "Marketing Site",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 -m http.server 8090",
      "cwd": "${workspaceFolder}/site"
    }
  ]
}
